**/*histories*
**/histories.txt
results/**/slurm/
antigentools.egg-info/

# Ignore large raw antigen-outputs (viruses.csv is ~250M+)
data/**/antigen-outputs/viruses.csv
data/toy-example/
data/flu-simulated-150k-samples-final/
# Ignore compiled Python files
**/*.pyc

# Claude files
CLAUDE.md
.claude

# Temp stuff for repo cleanup
*_tree.json
*_data.json
*.nwk
*.fasta.log
*.iqtree.log
iqtree*

# Ignore tests for now.
#antigentools/tests/
run_tests.py
pytest.ini

# Ignore generated model config files
config_*.json
issues/

# Pathogen-embed files (keep tar archive and seq-clusters.csv)
data/**/pathogen-embed/distance-matrix.csv
data/**/pathogen-embed/mds-embeddings.csv
data/**/pathogen-embed/sequences.alignment
data/**/pathogen-embed/sequences.alignment.insertions.csv
data/**/pathogen-embed/sequences.alignment.log
# Keep: pathogen-embed.tar.gz and seq-clusters.csv

# Large FASTA files (keep compressed versions)
data/**/antigen-outputs/sequences.fasta
# Keep: sequences.fasta.gz

# Large TSV files
data/**/tips_forecasting.tsv

# Tar.gz archives of results
data/**/antigen-outputs/*.tar.gz
.beads/

# Large files to exclude (>7.5M or intermediate alignment files)
data/**/viruses.csv
data/**/distance-matrix.csv
data/**/nt_muts.json
data/**/*.alignment

# Beads file
AGENTS.md

# Large per-run sweep result trees; aggregate to results/aggregated/ and commit
# only those small CSVs (see scripts/aggregate_results.py). results/aggregated/
# does not match these patterns.
results/**/estimates/
results/**/growth-rates/
results/**/convergence-diagnostics/
# Large per-run assigned-variants table (input to aggregation, not committed).
data/**/tips_with_variants.tsv
# Local diagnostic figures (scripts/make_figureS3.sh and friends). These are for
# inspecting a single build, not manuscript output, so they belong in neither
# this repo's history nor the paper repo.
results/diagnostics/
# Defunct raw per-point scores concatenation (too large to commit; superseded by
# scores_summary.csv from scripts/aggregate_results.py).
results/aggregated/**/scores_all.csv
# Timestamped SLURM staging dirs written by run_all_simulations.py,
# submit_aggregation.sh, submit_homoplasy_sweep.sh, and submit_truetree_sweep.sh;
# regenerated on every submission.
results/**/slurm_submission_*/
results/**/aggregation_submission_*/
results/**/homoplasy_submission_*/
results/**/truetree_submission_*/

# Sweep/aggregation logs land beside the committable CSVs in results/aggregated/;
# they are regenerable, so keep the aggregated dir to small CSVs only.
results/aggregated/**/*.log

# Manual result/data backups (e.g. *.pre-clade-weights-fix) and ad-hoc HPC
# re-run scripts staged loosely under results/<batch>/.
results/**/*.pre-*
data/**/*.pre-*
results/**/*.sbatch
results/**/*_sims.txt

# Local working specs/notes (not committed docs).
specs/
# Final figures are written to ../antigen-tex/figures/<batch>/, not committed here.
figures/
# Regenerable candidate-run browser PDFs (scripts/browse_candidate_runs.py); large
# and reproducible on demand, so kept out of git wherever they land.
browse_candidate_runs*.pdf

# Per-run sweep scratch (HPC). The pipeline writes a data tree and scoring artifacts
# for every run of every config; only the aggregated CSVs (results/aggregated/) and
# the per-run variant_growth_rates.tsv are committed. Everything else is regenerable
# pipeline output and stays out of git. Per-run data trees (all configs):
data/**/*__run_*/
# Per-run scoring artifacts (filename-scoped so the tracked variant_growth_rates.tsv
# is never masked):
results/**/*__run_*/scores.tsv
results/**/*__run_*/growth_rate_scores.tsv
results/**/*__run_*/vi_convergence_diagnostics.tsv
results/**/*__run_*/pipeline.log
results/**/*__run_*/benchmark_config.yaml
# Smoke-test scratch and SLURM logs.
data/smoke-test/
results/smoke-test/
logs/

# local scratch space, never tracked
scratchpad/
